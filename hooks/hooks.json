{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || python \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || python \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || python \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || python \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || python \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/state/hook_event.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
